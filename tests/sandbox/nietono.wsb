<!--
  Runs the integration test in Windows Sandbox, a throwaway copy of Windows.
  Build first with `cargo build --release`, then open this file. Edit the
  host path below if the repository lives somewhere else.
-->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\src\nietono</HostFolder>
      <SandboxFolder>C:\nietono</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\nietono\tests\integration.ps1 -Exe C:\nietono\target\release\nietono.exe</Command>
  </LogonCommand>
</Configuration>
